# Copy this file to .env and adjust if needed. Defaults work out of the box for local dev.

# Warehouse Postgres (also hosts the Airflow metadata DB, in a separate database)
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse

# Airflow
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Safe to leave blank for local dev - Airflow will still run, just without encrypted connections.
AIRFLOW__CORE__FERNET_KEY=
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# webapp service only - signs session cookies; set a real random value if
# this app is ever reachable beyond your own machine
SESSION_SECRET_KEY=local-dev-only-secret-change-if-ever-deployed

# webapp service only - leave unset to leave the Metabase section showing
# "not configured"; see README "Embedding Metabase" for how to get these
METABASE_SITE_URL=http://localhost:3000
METABASE_EMBED_SECRET=
METABASE_DASHBOARD_ID=

# Host ports for the Docker Airflow / Metabase UIs (change if 8080 / 3000 are taken)
#AIRFLOW_PORT=8080
#METABASE_PORT=3000
