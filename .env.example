# Copy this file to .env if you want to override any defaults, or source it before
# running scripts manually. The Python scripts fall back to these exact values if
# the env vars aren't set, so this file is optional for the default local setup.

WAREHOUSE_DB_HOST=localhost
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=warehouse
WAREHOUSE_DB_USER=warehouse
WAREHOUSE_DB_PASSWORD=warehouse

# api/ (the web app) only - the role the "run SQL" tool connects as
APP_READONLY_DB_USER=app_readonly
APP_READONLY_DB_PASSWORD=app_readonly

# api/ only - signs session cookies; set a real random value if this app is
# ever reachable beyond your own machine
SESSION_SECRET_KEY=local-dev-only-secret-change-if-ever-deployed

# api/ only - leave unset to leave the Metabase section showing "not
# configured"; see README "Embedding Metabase" for how to get these
METABASE_SITE_URL=http://localhost:3000
METABASE_EMBED_SECRET=
METABASE_DASHBOARD_ID=
